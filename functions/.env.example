# Copie para functions/.env (NÃO versionar) e preencha.
# O firebase-functions v2 carrega este arquivo automaticamente no deploy e no emulador.

# Token de acesso da aplicação Mercado Pago
# Sandbox/testes: credenciais de teste (TEST-...). Produção: APP_USR-...
MP_ACCESS_TOKEN=

# Assinatura secreta do webhook (painel MP > Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=

# URL pública do painel do cliente (back_url pós-checkout)
PAINEL_URL=https://painel.vitrinevirt.com
